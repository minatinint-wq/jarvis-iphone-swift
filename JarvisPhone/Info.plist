<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>NSSupportsLiveActivities</key><true/>
    <key>CFBundleDisplayName</key><string>JARVIS XLV</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>NSMotionUsageDescription</key><string>O Jarvis consulta os passos registrados hoje pelo iPhone.</string>
    <key>NSCalendarsFullAccessUsageDescription</key><string>O Jarvis lê o próximo compromisso para avisar quando ele estiver perto.</string>
    <key>NSContactsUsageDescription</key><string>O Jarvis encontra o telefone do contato que você pedir para ligar ou enviar SMS.</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleDevelopmentRegion</key><string>pt_BR</string>
    <key>CFBundleURLTypes</key><array><dict>
        <key>CFBundleURLName</key><string>com.jarvisxlv.iphone.command</string>
        <key>CFBundleURLSchemes</key><array><string>jarvisiphone</string></array>
    </dict></array>
    <key>LSApplicationQueriesSchemes</key><array><string>whatsapp</string><string>instagram</string><string>shortcuts</string></array>
    <key>NSSpeechRecognitionUsageDescription</key><string>Reconhecer “Oi Jarvis” e o pedido seguinte no próprio iPhone quando você ativa a escuta.</string>
    <key>UIBackgroundModes</key><array><string>audio</string></array>
    <key>NSMicrophoneUsageDescription</key><string>Reconhecer “Oi Jarvis” durante a escuta opcional e transmitir sua fala ao Jarvis no PC quando você usa o botão de conversa.</string>
    <key>NSCameraUsageDescription</key><string>Tirar uma foto para análise pela NVIDIA no seu Jarvis, capturar uma foto ou usar a lanterna.</string>
    <key>NSPhotoLibraryAddUsageDescription</key><string>Salvar em Fotos as imagens que você capturar pelo JARVIS.</string>
    <key>NSLocationWhenInUseUsageDescription</key><string>Usar sua localização para consultar o tempo, abrir o Mapas e ajudar a selecionar mapas de realidade aumentada próximos.</string>
    <key>NSRemindersFullAccessUsageDescription</key><string>Salvar os lembretes que você criar pelo JARVIS no app Lembretes.</string>
    <key>UILaunchScreen</key><dict/>
    <key>UIApplicationSceneManifest</key><dict>
        <key>UIApplicationSupportsMultipleScenes</key><false/>
        <key>UISceneConfigurations</key><dict/>
    </dict>
    <key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
    <key>UIApplicationSupportsIndirectInputEvents</key><true/>
    <key>ITSAppUsesNonExemptEncryption</key><false/>
</dict></plist>
