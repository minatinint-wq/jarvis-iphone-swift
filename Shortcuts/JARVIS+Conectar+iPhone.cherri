#define name JARVIS+Conectar+iPhone
#define version 17
#define mac false
#define color teal
#define glyph gear
#define inputs text
#include 'actions/web'
#include 'actions/text'
#include 'actions/documents'
#include 'actions/shortcuts'
#include 'actions/sharing'

@entry = "{ShortcutInput}"
const entryLength = count(@entry, "Characters")
if entryLength == 0 {
    @entry = prompt("Cole endereço|código do painel iPhone do Jarvis.")
}
const parts = splitText(@entry, "|")
const partsLength = count(parts)
if partsLength != 2 {
    show("Leia o QR atual do painel iPhone no PC.")
    stop()
}
const serverURL = getFirstItem(parts)
const pairCode = getLastItem(parts)
const hosts = matchText('^http://(10[.][0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}|192[.]168[.][0-9]{1,3}[.][0-9]{1,3}|172[.](1[6-9]|2[0-9]|3[01])[.][0-9]{1,3}):[0-9]{2,5}$', "{serverURL}")
const hostCount = count(hosts)
if hostCount != 1 { stop() }
const reply = jsonRequest("{serverURL}/v1/pair", "POST", {"code":"{pairCode}"})
const response = getDictionary(reply)
const token = getValue(response, "token")
const tokenLength = count(token, "Characters")
if tokenLength < 20 {
    show("O QR expirou. Peça Conectar iPhone ao Jarvis para gerar outro.")
    stop()
}
const topic = getValue(response, "notification_topic")
const topicLength = count(topic, "Characters")
if topicLength < 30 {
    show("Gere o QR da ponte por notificação no painel atualizado do Jarvis.")
    stop()
}
const config = {"server":"{serverURL}","token":"{token}"}
const configText = getText(config)
const namedConfig = setName(configText, "JARVIS-iPhone.json")
saveFilePrompt(namedConfig, true)
const activation = jsonRequest("{serverURL}/v1/background/activate", "POST", {"source":"PHONE_PAIRING"}, {"Authorization":"Bearer {token}"})
const activationText = getText(activation)
const approved = matchText('"ok"\s*:\s*true', activationText)
const approvalCount = count(approved)
if approvalCount != 1 {
    show("A ponte nao confirmou a ativacao. Confira o Jarvis no PC; a conexao nao foi marcada como concluida.")
    stop()
}
setClipboard(topic, true)
show("Conexao salva. Em Executar+Comando e Notificacoes, escolha o JSON salvo em No Meu iPhone no primeiro cartao Arquivo. O canal do ntfy foi copiado: cole na assinatura ntfy.sh. Crie a automacao ntfy com titulo JARVIS_COMANDO para executar imediatamente Executar+Comando.")
