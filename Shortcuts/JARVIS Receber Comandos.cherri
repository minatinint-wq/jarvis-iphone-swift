#define name JARVIS Receber Comandos
#define version 17
#define mac false
#define color teal
#define glyph gear
#define inputs text
#include 'actions/device'
#include 'actions/web'
#include 'actions/text'
#include 'actions/shortcuts'

@entry = "{ShortcutInput}"
const entryLength = count(@entry, "Characters")
if entryLength == 0 {
    @entry = prompt("Cole o endereço|código mostrado no painel iPhone do Jarvis.")
}
const parts = splitText(@entry, "|")
const partsLength = count(parts)
if partsLength != 2 {
    show("Leia o QR atual no painel iPhone do Jarvis para conectar.")
    stop()
}
const serverURL = getFirstItem(parts)
const pairCode = getLastItem(parts)
const hosts = matchText('^http://(10[.][0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}|192[.]168[.][0-9]{1,3}[.][0-9]{1,3}|172[.](1[6-9]|2[0-9]|3[01])[.][0-9]{1,3}[.][0-9]{1,3}):[0-9]{2,5}$', "{serverURL}")
const hostCount = count(hosts)
if hostCount != 1 {
    show("Use o endereço da rede Wi-Fi local mostrado pelo Jarvis no PC.")
    stop()
}
const response = jsonRequest("{serverURL}/v1/pair", "POST", {"code":"{pairCode}"})
@connection = getDictionary(response)
@token = getValue(@connection, "token")
const tokenLength = count(@token, "Characters")
if tokenLength < 20 {
    show("O código expirou ou já foi usado. Peça Conectar iPhone ao Jarvis e leia o novo QR.")
    stop()
}
showNotification("Conectado ao Jarvis. Mantenha este receptor em execução para receber comandos por voz do PC.", "JARVIS iPhone", false)
repeat cycle for 10000 {
    const currentBrightness = getDeviceDetail("Current Brightness")
    const currentVolume = getDeviceDetail("Current Volume")
    const packet = jsonRequest("{serverURL}/v1/next", "POST", {"brilho":"{currentBrightness}","volume":"{currentVolume}"}, {"Authorization":"Bearer {@token}"})
    @command = getDictionary(packet)
    const actionName = getValue(@command, "action")
    @action = "{actionName}"
    @identifier = getValue(@command, "id")
    @done = 0
    if @action == "brilho" {
        @value = getValue(@command, "value")
        const brightnessFraction = @value / 100
        rawAction("is.workflow.actions.setbrightness", {"WFBrightness":"${brightnessFraction}"})
        @done = 1
    }
    if @action == "volume" {
        @value = getValue(@command, "value")
        const volumeFraction = @value / 100
        rawAction("is.workflow.actions.setvolume", {"WFVolume":"${volumeFraction}","WFVolumeControlType":"Media"})
        @done = 1
    }
    if @action == "lanterna_ligar" {
        flashlightOn(1.0)
        @done = 1
    }
    if @action == "lanterna_desligar" {
        flashlightOff()
        @done = 1
    }
    if @action == "social" {
        const socialRawPlan = getValue(@command, "value")
        const socialPlan = getDictionary(socialRawPlan)
        const socialOperation = getValue(socialPlan, "operation")
        const socialRecipient = getValue(socialPlan, "recipient")
        const socialText = getValue(socialPlan, "text")
        const socialUsername = getValue(socialPlan, "username")
        const socialSubject = getValue(socialPlan, "subject")
        const socialInput = {"operation":"{socialOperation}","recipient":"{socialRecipient}","text":"{socialText}","username":"{socialUsername}","subject":"{socialSubject}","apiBase":"{serverURL}","apiToken":"{@token}"}
        jsonRequest("{serverURL}/v1/ack", "POST", {"id":"{@identifier}","stage":"handed_off"}, {"Authorization":"Bearer {@token}"})
        run("JARVIS Social", socialInput)
    }
    if @done == 1 {
        jsonRequest("{serverURL}/v1/ack", "POST", {"id":"{@identifier}"}, {"Authorization":"Bearer {@token}"})
    }
}
show("Sessão encerrada. Peça Conectar iPhone ao Jarvis para iniciar outra sessão.")
