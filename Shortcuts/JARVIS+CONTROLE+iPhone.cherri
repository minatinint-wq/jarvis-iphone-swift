#define name JARVIS+CONTROLE+iPhone
#define version 17
#define mac false
#define color orange
#define glyph gear
#include 'actions/device'
#include 'actions/web'
#include 'actions/text'
#include 'actions/documents'
#include 'actions/shortcuts'

action 'file' localConnectionFile(): variable

// No editor, selecione uma vez o JSON em No Meu iPhone/JARVIS neste cartao Arquivo.
// A referencia local evita o iCloud e nao abre seletor durante as automacoes.
const saved = localConnectionFile()
const configText = getText(saved)
const config = getDictionary(configText)
const rawServer = getValue(config, "server")
const rawToken = getValue(config, "token")
const serverURL = "{rawServer}"
const token = "{rawToken}"
const validHosts = matchText('^http://(10[.][0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}|192[.]168[.][0-9]{1,3}[.][0-9]{1,3}|172[.](1[6-9]|2[0-9]|3[01])[.][0-9]{1,3}):[0-9]{2,5}$', serverURL)
const hostCount = count(validHosts)
const keyLength = count(token, "Characters")
if hostCount != 1 {
    show("O arquivo selecionado nao forneceu um endereco local valido. Escolha JARVIS-iPhone.json no primeiro cartao Arquivo.")
    stop()
}
if keyLength < 20 {
    show("A chave nao foi lida do arquivo selecionado. Escolha JARVIS-iPhone.json. Nao compartilhe o conteudo desse arquivo.")
    stop()
}
// O evento não fornece ações. Toda ação vem da caixa autenticada do Jarvis.
repeat cycle for 8 {
    const currentBrightness = getDeviceDetail("Current Brightness")
    const currentVolume = getDeviceDetail("Current Volume")
    const packet = jsonRequest("{serverURL}/v1/next-once", "POST", {"brilho":"{currentBrightness}","volume":"{currentVolume}"}, {"Authorization":"Bearer {token}"})
    const command = getDictionary(packet)
    const identifier = getValue(command, "id")
    const actionName = getValue(command, "action")
    @action = "{actionName}"
    if @action == "idle" {
        const probe = getValue(command, "probe_id")
        const probeLength = count(probe, "Characters")
        if probeLength > 8 {
            jsonRequest("{serverURL}/v1/background/ack", "POST", {"probe_id":"{probe}"}, {"Authorization":"Bearer {token}"})
        }
        stop()
    }
    @done = 0
    if @action == "brilho" {
        const brightnessValue = getValue(command, "value")
        const brightnessFraction = brightnessValue / 100
        rawAction("is.workflow.actions.setbrightness", {"WFBrightness":"${brightnessFraction}"})
        @done = 1
    }
    if @action == "volume" {
        const volumeValue = getValue(command, "value")
        const volumeFraction = volumeValue / 100
        rawAction("is.workflow.actions.setvolume", {"WFVolume":"${volumeFraction}","WFVolumeControlType":"Media"})
        @done = 1
    }
    if @action == "lanterna_ligar" {
        flashlightOn(1.0)
        @done = 1
    }
    if @action == "lanterna_desligar" {
        flashlightOff()
        @done = 1
    }
    if @action == "social" {
        const rawPlan = getValue(command, "value")
        const plan = getDictionary(rawPlan)
        const operation = getValue(plan, "operation")
        const recipient = getValue(plan, "recipient")
        const message = getValue(plan, "text")
        const username = getValue(plan, "username")
        const subject = getValue(plan, "subject")
        const socialInput = {"operation":"{operation}","recipient":"{recipient}","text":"{message}","username":"{username}","subject":"{subject}","apiBase":"{serverURL}","apiToken":"{token}"}
        jsonRequest("{serverURL}/v1/ack", "POST", {"id":"{identifier}","stage":"handed_off"}, {"Authorization":"Bearer {token}"})
        run("JARVIS+SOCIAL", socialInput)
        stop()
    }
    if @done == 1 {
        const actualBrightness = getDeviceDetail("Current Brightness")
        const actualVolume = getDeviceDetail("Current Volume")
        jsonRequest("{serverURL}/v1/ack", "POST", {"id":"{identifier}","brilho":"{actualBrightness}","volume":"{actualVolume}"}, {"Authorization":"Bearer {token}"})
    }
}
