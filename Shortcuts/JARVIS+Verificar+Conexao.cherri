#define name JARVIS+Verificar+Conexao
#define version 17
#define mac false
#define color teal
#define glyph gear
#include 'actions/documents'
#include 'actions/text'
#include 'actions/web'

// Escolha o JSON local. O resultado nunca mostra o segredo guardado nele.
const selected = selectFile(false)
const config = getDictionary(selected)
const serverURL = getValue(config, "server")
const token = getValue(config, "token")
const hosts = matchText('^http://(10[.][0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}|192[.]168[.][0-9]{1,3}[.][0-9]{1,3}|172[.](1[6-9]|2[0-9]|3[01])[.][0-9]{1,3}):[0-9]{2,5}$', "{serverURL}")
const hostCount = count(hosts)
const tokenLength = count(token, "Characters")
if hostCount != 1 {
    show("Esse arquivo não contém um endereço local válido do Jarvis. Escolha JARVIS-iPhone.json.")
    stop()
}
if tokenLength < 20 {
    show("Esse arquivo não contém a chave completa da conexão. Não compartilhe seu conteúdo.")
    stop()
}
const result = jsonRequest("{serverURL}/v1/background/activate", "POST", {"source":"PHONE_FILE_CHECK"}, {"Authorization":"Bearer {token}"})
show("Servidor: {serverURL}\nResultado da verificação: {result}\nNenhum ajuste do celular foi executado.")
